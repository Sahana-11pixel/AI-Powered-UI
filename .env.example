# Backend Environment Variables
# Copy this to .env and fill in your actual credentials

# MongoDB
MONGO_URI=your_mongodb_connection_string
DB_NAME=ui_codegen_java

# JWT (must be at least 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Firebase — NOT stored here!
# Instead, download your service account JSON from Firebase Console
# and save it as: firebase-service-account.json in the project root.
# Optionally set a custom path:
# FIREBASE_CREDENTIALS_FILE=path/to/your/file.json

# Cloudinary (for image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
